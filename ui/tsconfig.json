{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"moduleResolution": "bundler",
		"module": "esnext",
		"target": "es2022",
		"checkJs": false,
		"strict": true,
		"allowJs": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": [
		"src/**/*.d.ts",
		"src/**/*.ts",
		"src/**/*.js",
		"src/**/*.svelte"
	]
}
